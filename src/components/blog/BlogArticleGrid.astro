---
const { articles, currentPage, totalPages } = Astro.props;
---

<div class="journal-page">
  <section class="journal-grid" aria-label="Journal articles">
    {articles.map((article) => (
      <article class="journal-card">
        {article.cardImage !== null && (
          <a href={`/blog/${article.slug}`} class="journal-image" aria-label={`Read ${article.title}`}>
            <img
              src={article.cardImage ?? article.image}
              alt={article.title}
              width={article.cardImageDimensions?.width ?? article.imageDimensions.width}
              height={article.cardImageDimensions?.height ?? article.imageDimensions.height}
              loading="lazy"
              decoding="async"
            />
          </a>
        )}
        <div class="journal-copy">
          {article.publishedAt && (
            <time datetime={article.publishedAt}>
              <svg aria-hidden="true" viewBox="0 0 16 16">
                <path d="M4.5 1.5v2m7-2v2M2.5 5.5h11m-10 9h9a1 1 0 0 0 1-1v-9a1 1 0 0 0-1-1h-9a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1Z" />
              </svg>
              {new Date(`${article.publishedAt}T00:00:00`).toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
              })}
            </time>
          )}
          <h2><a href={`/blog/${article.slug}`}>{article.title}</a></h2>
          <a class="journal-link" href={`/blog/${article.slug}`}>
            Read More <span aria-hidden="true">»</span>
          </a>
        </div>
      </article>
    ))}
  </section>

  <nav class="journal-pagination" aria-label="Journal pages">
    {currentPage > 1 ? (
      <a href={currentPage === 2 ? "/blog" : `/blog/page/${currentPage - 1}`} rel="prev">
        <span aria-hidden="true">←</span> Previous
      </a>
    ) : <span class="pagination-disabled">← Previous</span>}

    <div class="pagination-pages">
      {Array.from({ length: totalPages }, (_, index) => {
        const page = index + 1;
        const href = page === 1 ? "/blog" : `/blog/page/${page}`;
        return currentPage === page
          ? <span aria-current="page">{page}</span>
          : <a href={href}>{page}</a>;
      })}
    </div>

    {currentPage < totalPages ? (
      <a href={`/blog/page/${currentPage + 1}`} rel="next">
        Next <span aria-hidden="true">→</span>
      </a>
    ) : <span class="pagination-disabled">Next →</span>}
  </nav>
</div>

<style>
  .journal-page {
    padding: 75px 7% 100px;
    background: #eee8dc;
  }

  .journal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 42px;
    max-width: 1280px;
    margin: auto;
  }

  .journal-card {
    min-width: 0;
    animation: journal-card-in 0.55s ease both;
  }

  .journal-card:nth-child(2n) {
    animation-delay: 0.06s;
  }

  .journal-image {
    position: relative;
    display: block;
    aspect-ratio: 3.75 / 1;
    overflow: hidden;
    background: #dcc5a1;
  }

  .journal-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .journal-image:hover img {
    transform: scale(1.05);
  }

  .journal-copy {
    padding-top: 12px;
  }

  .journal-copy time {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #706d65;
    font-size: 12px;
    line-height: 1.4;
  }

  .journal-copy time svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .journal-copy h2 {
    margin: 10px 0 8px;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
  }

  .journal-copy h2 a {
    color: #244537;
    text-decoration: none;
  }

  .journal-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    color: #a64f37;
    font-size: 10px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .journal-link span {
    transition: transform 0.25s ease;
  }

  .journal-link:hover span {
    transform: translateX(4px);
  }

  .journal-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
    max-width: 1280px;
    margin: 55px auto 0;
    color: #244537;
    font-size: 13px;
  }

  .journal-pagination a,
  .pagination-pages span {
    color: inherit;
    text-decoration: none;
  }

  .journal-pagination a:hover {
    color: #a64f37;
  }

  .pagination-pages {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .pagination-pages a,
  .pagination-pages span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
  }

  .pagination-pages [aria-current="page"] {
    background: #244537;
    color: #f8f4eb;
  }

  .pagination-disabled {
    opacity: 0.4;
  }

  .journal-pagination :focus-visible,
  .journal-copy a:focus-visible,
  .journal-image:focus-visible {
    outline: 2px solid #a64f37;
    outline-offset: 4px;
  }

  @keyframes journal-card-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 620px) {
    .journal-page {
      padding: 70px 6%;
    }

    .journal-grid {
      grid-template-columns: 1fr;
      row-gap: 34px;
    }

    .journal-image {
      aspect-ratio: 2.8 / 1;
    }

    .journal-pagination {
      flex-wrap: wrap;
      gap: 12px;
      font-size: 11px;
    }

    .pagination-pages {
      order: 3;
      flex-basis: 100%;
      gap: 2px;
    }

    .pagination-pages a,
    .pagination-pages span {
      width: 30px;
      height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-card {
      animation: none;
    }

    .journal-image img,
    .journal-link span {
      transition: none;
    }
  }
</style>
