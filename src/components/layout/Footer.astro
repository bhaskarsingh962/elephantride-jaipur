---
import { siteConfig } from "../../data/siteConfig.js";
---

<footer class="bg-forest px-6 pb-6 pt-16 text-ivory md:px-12">
  <div class="mx-auto grid min-w-0 max-w-[1440px] gap-12 md:grid-cols-3">
    <div class="min-w-0">
      <h2 class="break-words font-heading text-3xl tracking-wider">ELEPHANT RIDE JAIPUR</h2>
      <p class="mt-5 max-w-sm text-sm leading-7 text-ivory/75">
        Discover elephant experiences in Jaipur, Rajasthan, with Elephant Ride Jaipur.
      </p>
    </div>

    <div class="min-w-0">
      <h3 class="mb-5 text-sm font-semibold uppercase tracking-widest">
        Explore
      </h3>
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          class="mb-3 block text-sm text-ivory/75 hover:text-antique-gold"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="min-w-0">
      <h3 class="mb-5 text-sm font-semibold uppercase tracking-widest">
        Get in touch
      </h3>
      <a href={`tel:${siteConfig.phone}`} class="mb-3 block text-sm">
        {siteConfig.displayPhone}
      </a>
      <a href={`tel:${siteConfig.additionalPhone}`} class="mb-3 block text-sm">
        {siteConfig.displayAdditionalPhone}
      </a>
      <a href={`mailto:${siteConfig.email}`} class="block break-words text-sm">
        {siteConfig.email}
      </a>
      <a
        href={`https://wa.me/${siteConfig.whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 block text-sm"
      >
        WhatsApp Elephant Ride Jaipur ↗
      </a>
      <a
        href={siteConfig.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 block text-sm"
      >
        Instagram Elephant Ride Jaipur ↗
      </a>
      <a
        href={siteConfig.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 block text-sm"
      >
        YouTube Elephant Ride Jaipur ↗
      </a>
      <p class="mt-5 max-w-sm break-words text-sm leading-7 text-ivory/75">
        {siteConfig.address}
      </p>
      <a
        href={siteConfig.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-block text-sm text-antique-gold"
      >
        Get directions ↗
      </a>
    </div>
  </div>

  <div class="mx-auto mt-14 flex max-w-[1440px] flex-col justify-between gap-4 border-t border-ivory/20 pt-6 text-xs text-ivory/70 md:flex-row">
    <p>© {new Date().getFullYear()} Elephant Ride Jaipur. All rights reserved.</p>
    <div class="flex flex-wrap gap-5">
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms">Terms &amp; Conditions</a>
    </div>
  </div>
</footer>
