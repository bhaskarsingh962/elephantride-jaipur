---
import { siteConfig } from "../../data/siteConfig.js";
---

<footer class="bg-forest px-6 pb-6 pt-16 text-ivory md:px-12">
  <div class="mx-auto grid min-w-0 max-w-[1440px] gap-12 md:grid-cols-3">
    <div class="min-w-0">
      <h2 class="break-words font-heading text-3xl tracking-wider">JAIPUR ELEPHANT RIDE</h2>
      <p class="mt-5 max-w-sm text-sm leading-7 text-ivory/75">
        Discover elephant experiences in Jaipur, Rajasthan, with Jaipur Elephant Ride.
      </p>
    </div>

    <div class="min-w-0">
      <h3 class="mb-5 text-sm font-semibold uppercase tracking-widest">
        Explore
      </h3>
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          class="mb-3 block text-sm text-ivory/75 hover:text-antique-gold"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="min-w-0">
      <h3 class="mb-5 text-sm font-semibold uppercase tracking-widest">
        Get in touch
      </h3>
      <a
        href={`tel:${siteConfig.phone}`}
        aria-label={`Call ${siteConfig.displayPhone}`}
        class="mb-3 inline-flex items-center gap-2 text-sm"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 3.75h3l1.5 4.5-2.25 1.5a15.75 15.75 0 0 0 7.5 7.5l1.5-2.25 4.5 1.5v3a1.5 1.5 0 0 1-1.65 1.5A18.75 18.75 0 0 1 3 5.4 1.5 1.5 0 0 1 4.5 3.75Z" />
        </svg>
        {siteConfig.displayPhone}
      </a>
      <a
        href={`tel:${siteConfig.additionalPhone}`}
        aria-label={`Call ${siteConfig.displayAdditionalPhone}`}
        class="mb-3 inline-flex items-center gap-2 text-sm"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 3.75h3l1.5 4.5-2.25 1.5a15.75 15.75 0 0 0 7.5 7.5l1.5-2.25 4.5 1.5v3a1.5 1.5 0 0 1-1.65 1.5A18.75 18.75 0 0 1 3 5.4 1.5 1.5 0 0 1 4.5 3.75Z" />
        </svg>
        {siteConfig.displayAdditionalPhone}
      </a>
      <a href={`mailto:${siteConfig.email}`} class="block break-words text-sm">
        {siteConfig.email}
      </a>
      <a
        href={`https://wa.me/${siteConfig.whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 block text-sm"
      >
        WhatsApp Jaipur Elephant Ride ↗
      </a>
      <a
        href={siteConfig.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 block text-sm"
      >
        Instagram Jaipur Elephant Ride ↗
      </a>
      <a
        href={siteConfig.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 block text-sm"
      >
        YouTube Jaipur Elephant Ride ↗
      </a>
      <div class="mt-5 space-y-4 text-sm leading-7 text-ivory/75">
        <div>
          <p class="font-semibold text-ivory">Office</p>
          <p class="break-words">{siteConfig.officeAddress}</p>
          <a
            href={siteConfig.officeMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-antique-gold"
          >
            Office directions ↗
          </a>
        </div>
        <div>
          <p class="font-semibold text-ivory">Farm</p>
          <p class="break-words">{siteConfig.farmAddress}</p>
          <a
            href={siteConfig.farmMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-antique-gold"
          >
            Farm directions ↗
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto mt-14 flex max-w-[1440px] flex-col justify-between gap-4 border-t border-ivory/20 pt-6 text-xs text-ivory/70 md:flex-row">
    <p>© {new Date().getFullYear()} Jaipur Elephant Ride. All rights reserved.</p>
    <div class="flex flex-wrap gap-5">
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms">Terms &amp; Conditions</a>
    </div>
  </div>
</footer>
