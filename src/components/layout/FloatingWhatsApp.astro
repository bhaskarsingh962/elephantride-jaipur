---
import { siteConfig } from "../../data/siteConfig.js";

const message = "Hello, I would like to know more about Jaipur Elephant Ride.";
const href = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(message)}`;
---

<a
  class="floating-whatsapp"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Jaipur Elephant Ride on WhatsApp"
  title="Chat with Jaipur Elephant Ride on WhatsApp"
>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path
      d="M16 3.25A12.6 12.6 0 0 0 5.18 22.3L3.5 28.5l6.36-1.64A12.6 12.6 0 1 0 16 3.25Z"
    />
    <path
      d="M12.04 10.1c-.25-.55-.52-.57-.76-.58h-.65c-.23 0-.61.09-.93.44-.32.35-1.22 1.19-1.22 2.9s1.25 3.37 1.43 3.61c.17.23 2.42 3.88 5.98 5.28 2.96 1.16 3.56.93 4.2.87.64-.06 2.07-.84 2.36-1.65.29-.81.29-1.51.2-1.65-.09-.15-.32-.24-.67-.41-.35-.17-2.07-1.02-2.39-1.13-.32-.12-.55-.18-.78.17-.23.35-.9 1.13-1.11 1.36-.21.24-.41.27-.76.09-.35-.17-1.48-.55-2.82-1.75-1.04-.93-1.74-2.08-1.94-2.43-.2-.35-.02-.54.15-.71.15-.15.35-.41.52-.61.18-.2.23-.35.35-.58.12-.23.06-.44-.03-.61-.09-.18-.78-1.91-1.1-2.6Z"
    />
  </svg>
  <span>Chat with us</span>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    right: max(22px, env(safe-area-inset-right));
    bottom: max(22px, env(safe-area-inset-bottom));
    z-index: 950;
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    gap: 10px;
    padding: 0 18px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: #188c55;
    box-shadow: 0 8px 26px rgba(20, 54, 37, 0.24);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .floating-whatsapp:hover {
    transform: translateY(-3px);
    background: #117447;
    box-shadow: 0 12px 30px rgba(20, 54, 37, 0.3);
  }

  .floating-whatsapp:focus-visible {
    outline: 3px solid #a64f37;
    outline-offset: 4px;
  }

  .floating-whatsapp svg {
    width: 23px;
    height: 23px;
    fill: currentColor;
  }

  .floating-whatsapp svg path:first-child {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  @media (max-width: 480px) {
    .floating-whatsapp {
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
      width: 54px;
      height: 54px;
      justify-content: center;
      padding: 0;
    }

    .floating-whatsapp span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp {
      transition: none;
    }
  }
</style>
