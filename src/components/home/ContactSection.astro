
---
import { siteConfig } from "../../data/siteConfig.js";

const { headingLevel = "h1" } = Astro.props;
const phone = siteConfig.phone;
const displayPhone = siteConfig.displayPhone;
const additionalPhone = siteConfig.additionalPhone;
const displayAdditionalPhone = siteConfig.displayAdditionalPhone;
const email = siteConfig.email;
const officeAddress = siteConfig.officeAddress;
const farmAddress = siteConfig.farmAddress;
const officeMapUrl = siteConfig.officeMapsUrl;
const farmMapUrl = siteConfig.farmMapsUrl;
---

<div class="bg-ivory min-h-screen">

    <!-- PAGE INTRO -->
    <section class="px-6 md:px-12 pt-20 pb-14">
      <div class="max-w-[1440px] mx-auto">

        <p class="text-terracotta text-xs tracking-[4px] uppercase mb-6">
          PLAN YOUR EXPERIENCE
        </p>

        {headingLevel === "h1" ? (
          <h1 class="font-heading text-5xl md:text-7xl text-forest leading-tight">
            Let's Plan Your{" "}
            <span class="text-antique-gold italic">Visit.</span>
          </h1>
        ) : (
          <h2 class="font-heading text-5xl md:text-7xl text-forest leading-tight">
            Let's Plan Your{" "}
            <span class="text-antique-gold italic">Visit.</span>
          </h2>
        )}

        <p class="mt-6 max-w-xl text-gray-600 leading-8">
          Discover unforgettable elephant experiences in Jaipur.
          Get in touch with our team and plan your memorable visit.
        </p>

      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section class="px-6 md:px-12 pb-24">
      <div class="max-w-[1440px] mx-auto grid lg:grid-cols-5 gap-10">

        <!-- WHATSAPP ENQUIRY FORM -->
        <div class="lg:col-span-3 bg-white p-8 md:p-12 shadow-sm">

          <p class="text-terracotta text-xs tracking-[3px] uppercase">
            YOUR VISIT DETAILS
          </p>

          <h2 class="font-heading text-4xl text-forest mt-4 mb-4">
            Plan Your Visit
          </h2>

          <p class="text-gray-500 text-sm leading-7 mb-9">
            Fill in your details below. We'll open WhatsApp with your
            enquiry so you can send it directly to our team.
          </p>

          <form id="visit-form" class="space-y-7">

            <div class="grid md:grid-cols-2 gap-6">

              <div>
                <label for="name" class="form-label">Full Name *</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="Your full name"
                  required
                  class="form-input"
                />
              </div>

              <div>
                <label for="customer-phone" class="form-label">
                  Your Phone Number *
                </label>

                <input
                  id="customer-phone"
                  name="customerPhone"
                  type="tel"
                  placeholder="Your contact number"
                  required
                  class="form-input"
                />
              </div>

              <div>
                <label for="date" class="form-label">
                  Preferred Visit Date *
                </label>

                <input
                  id="date"
                  name="date"
                  type="date"
                  required
                  class="form-input"
                />
              </div>

            </div>

            <div>
              <label for="message" class="form-label">
                Additional Message
              </label>

              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Tell us more about your visit..."
                class="form-input resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="whatsapp-submit w-full md:w-auto"
            >
              <span>Send Enquiry on WhatsApp</span>
              <span>↗</span>
            </button>

            <p class="text-xs text-gray-500 leading-6">
              Your enquiry will open in WhatsApp. Please press Send
              there to share your details with our team. This does
              not confirm a booking.
            </p>

          </form>

        </div>

        <!-- CONTACT INFORMATION -->
        <div class="lg:col-span-2 bg-forest text-ivory p-8 md:p-12">

          <p class="text-antique-gold text-xs tracking-[3px] uppercase">
            GET IN TOUCH
          </p>

          <h2 class="font-heading text-4xl mt-6 leading-tight">
            We'd Love to Hear From You.
          </h2>

          <p class="text-ivory/70 text-sm leading-7 mt-5">
            Have questions or planning a visit? Reach out to us
            directly. Our team will be happy to assist you.
          </p>

          <div class="mt-12 space-y-9">

            <!-- PHONE -->
            <div>
              <p class="text-antique-gold text-xs tracking-widest uppercase mb-3">
                Call Us
              </p>

              <a
                href={`tel:${phone}`}
                aria-label={`Call ${displayPhone}`}
                class="inline-flex items-center gap-2 text-xl hover:text-antique-gold transition"
              >
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 3.75h3l1.5 4.5-2.25 1.5a15.75 15.75 0 0 0 7.5 7.5l1.5-2.25 4.5 1.5v3a1.5 1.5 0 0 1-1.65 1.5A18.75 18.75 0 0 1 3 5.4 1.5 1.5 0 0 1 4.5 3.75Z" />
                </svg>
                {displayPhone}
              </a>

              <a
                href={`tel:${additionalPhone}`}
                aria-label={`Call ${displayAdditionalPhone}`}
                class="mt-2 inline-flex items-center gap-2 text-xl hover:text-antique-gold transition"
              >
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 3.75h3l1.5 4.5-2.25 1.5a15.75 15.75 0 0 0 7.5 7.5l1.5-2.25 4.5 1.5v3a1.5 1.5 0 0 1-1.65 1.5A18.75 18.75 0 0 1 3 5.4 1.5 1.5 0 0 1 4.5 3.75Z" />
                </svg>
                {displayAdditionalPhone}
              </a>

              <a
                href={`https://wa.me/${siteConfig.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="block mt-3 text-sm text-ivory/70 hover:text-antique-gold"
              >
                Chat with us on WhatsApp ↗
              </a>
            </div>

            <!-- EMAIL -->
            <div>
              <p class="text-antique-gold text-xs tracking-widest uppercase mb-3">
                Email Us
              </p>

              <a
                href={`mailto:${email}`}
                class="text-base md:text-lg break-all hover:text-antique-gold transition"
              >
                {email}
              </a>
            </div>

            <!-- LOCATION -->
            <div>
              <p class="text-antique-gold text-xs tracking-widest uppercase mb-3">
                Office
              </p>

              <p class="text-base leading-7 text-ivory/90">
                {officeAddress}
              </p>

              <a
                href={officeMapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block mt-4 text-sm text-antique-gold hover:text-white"
              >
                Office Directions ↗
              </a>
            </div>

            <div>
              <p class="text-antique-gold text-xs tracking-widest uppercase mb-3">
                Visit Our Farm
              </p>

              <p class="text-base leading-7 text-ivory/90">
                {farmAddress}
              </p>

              <a
                href={farmMapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block mt-4 text-sm text-antique-gold hover:text-white"
              >
                Farm Directions ↗
              </a>
            </div>

            <div>
              <p class="text-antique-gold text-xs tracking-widest uppercase mb-3">
                Follow Jaipur Elephant Ride
              </p>
              <a
                href={siteConfig.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="mr-5 text-sm text-ivory/80 hover:text-antique-gold"
              >
                Instagram Jaipur Elephant Ride ↗
              </a>
              <a
                href={siteConfig.youtube}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-ivory/80 hover:text-antique-gold"
              >
                YouTube Jaipur Elephant Ride ↗
              </a>
            </div>

          </div>

          <div class="border-t border-white/20 mt-12 pt-8">
            <p class="text-xs tracking-widest uppercase text-antique-gold">
              JAIPUR ELEPHANT RIDE
            </p>

            <p class="text-sm text-ivory/70 mt-2">
              An unforgettable Jaipur experience.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- LOCATION SECTION -->
    <section class="px-6 md:px-12 pb-24">
      <div class="max-w-[1440px] mx-auto">

        <p class="text-terracotta text-xs tracking-[3px] uppercase mb-4">
          FIND US
        </p>

        <h2 class="font-heading text-4xl md:text-5xl text-forest mb-8">
          Visit Our Farm
        </h2>

        <div class="w-full h-[350px] md:h-[450px] overflow-hidden">
          <iframe
            src={`https://maps.google.com/maps?q=${encodeURIComponent(farmAddress)}&output=embed`}
            width="100%"
            height="100%"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Jaipur Elephant Ride farm location"
          ></iframe>
        </div>

        <a
          href={farmMapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-5 text-terracotta text-sm hover:text-forest"
        >
          Open Google Maps ↗
        </a>

      </div>
    </section>

</div>

<!-- WHATSAPP FORM HANDLER -->
<script>
  import { siteConfig } from "../../data/siteConfig.js";

  const form = document.querySelector("#visit-form");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const data = new FormData(form);

    const name = String(data.get("name") || "").trim();
    const customerPhone = String(data.get("customerPhone") || "").trim();
    const date = String(data.get("date") || "");
    const message = String(data.get("message") || "").trim();

    const whatsappMessage = `
Hello Jaipur Elephant Ride!

I would like to enquire about a visit.

*My Details*
Name: ${name}
Phone: ${customerPhone}

*Visit Details*
Preferred Date: ${date}

*Additional Message*
${message || "No additional message."}

Please share the availability and further details.

Thank you!
    `.trim();

    const whatsappUrl =
      `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(whatsappMessage)}`;

    window.open(whatsappUrl, "_blank", "noopener,noreferrer");
  });

  // Prevent selecting a past visit date.
  const dateInput = document.querySelector("#date");

  if (dateInput) {
    const today = new Date();
    const localDate = new Date(
      today.getTime() - today.getTimezoneOffset() * 60000
    ).toISOString().split("T")[0];

    dateInput.min = localDate;
  }
</script>
