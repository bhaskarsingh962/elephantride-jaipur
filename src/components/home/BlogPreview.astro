
---
import { featuredBlogArticles } from "../../data/blogArticles.js";

---

<section class="blog-preview">
  <div class="blog-container">

    <div class="blog-topline">
      <span></span>
      <p>THE JAIPUR ELEPHANT RIDE JOURNAL</p>
    </div>

    <div class="blog-heading">
      <div>
        <p class="blog-eyebrow">STORIES & INSPIRATION</p>
        <h2>
          Explore Our
          <em>Journal</em>
        </h2>
      </div>

      <div class="blog-heading-right">
        <p>
          Discover stories, travel inspiration and helpful
          information for your next Jaipur experience.
        </p>

        <a href="/blog" class="view-all-link">
          View All Articles <span>↗</span>
        </a>
      </div>
    </div>

    <div class="blog-grid">
      {featuredBlogArticles.slice(0, 3).map((article) => (
        <article class="blog-card">

          <a href={`/blog/${article.slug}`} class="blog-image">
            <img
              src={article.image}
              alt={article.title}
              width={article.imageDimensions.width}
              height={article.imageDimensions.height}
              loading="lazy"
              decoding="async"
            />

            <span class="blog-number">{article.number}</span>

            <span class="blog-image-arrow">↗</span>
          </a>

          <div class="blog-card-content">
            <span class="blog-category">
              {article.category}
            </span>

            <h3>
              <a href={`/blog/${article.slug}`}>
                {article.title}
              </a>
            </h3>

            <p>{article.description}</p>

            <a href={`/blog/${article.slug}`} class="read-more">
              Read Article <span>→</span>
            </a>
          </div>

        </article>
      ))}
    </div>

    <div class="blog-bottom">
      <span>TRAVEL · CULTURE · EXPERIENCES</span>
      <a href="/blog">EXPLORE THE JOURNAL ↗</a>
    </div>

  </div>
</section>

<style>
  .blog-preview {
    padding: 110px 7%;
    background: #eee8dc;
  }

  .blog-container {
    max-width: 1440px;
    margin: auto;
  }

  .blog-topline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 35px;
  }

  .blog-topline span {
    width: 38px;
    height: 1px;
    background: #b58a4b;
  }

  .blog-topline p,
  .blog-eyebrow {
    color: #a64f37;
    font-size: 10px;
    letter-spacing: 3px;
  }

  .blog-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 55px;
  }

  .blog-eyebrow {
    margin-bottom: 18px;
  }

  .blog-heading h2 {
    margin: 0;
    color: #244537;
    font-family: var(--font-heading);
    font-size: clamp(44px, 5vw, 72px);
    font-weight: 400;
    line-height: 1.05;
  }

  .blog-heading h2 em {
    color: #b58a4b;
    font-weight: 400;
  }

  .blog-heading-right {
    max-width: 350px;
  }

  .blog-heading-right p {
    color: #77736a;
    font-size: 13px;
    line-height: 1.9;
  }

  .view-all-link {
    display: inline-flex;
    gap: 20px;
    margin-top: 15px;
    padding-bottom: 9px;
    border-bottom: 1px solid #b58a4b;
    color: #244537;
    text-decoration: none;
    font-size: 12px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .blog-card {
    min-width: 0;
  }

  .blog-image {
    position: relative;
    display: block;
    height: 330px;
    overflow: hidden;
    background: #dcc5a1;
  }

  .blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .6s ease;
  }

  .blog-card:hover .blog-image img {
    transform: scale(1.06);
  }

  .blog-number {
    position: absolute;
    top: 15px;
    left: 15px;
    padding: 12px 15px;
    background: #f8f4eb;
    color: #244537;
    font-size: 11px;
  }

  .blog-image-arrow {
    position: absolute;
    right: 15px;
    bottom: 15px;
    display: grid;
    place-items: center;
    width: 45px;
    height: 45px;
    background: #dcc5a1;
    color: #244537;
    transition: background .3s;
  }

  .blog-card:hover .blog-image-arrow {
    background: #f8f4eb;
  }

  .blog-card-content {
    padding-top: 24px;
  }

  .blog-category {
    color: #a64f37;
    font-size: 9px;
    letter-spacing: 2px;
  }

  .blog-card h3 {
    margin: 14px 0;
    font-family: var(--font-heading);
    font-size: 29px;
    line-height: 1.2;
    font-weight: 400;
  }

  .blog-card h3 a {
    color: #244537;
    text-decoration: none;
    transition: color .3s;
  }

  .blog-card h3 a:hover {
    color: #a64f37;
  }

  .blog-card-content > p {
    min-height: 65px;
    color: #77736a;
    font-size: 13px;
    line-height: 1.8;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    margin-top: 15px;
    color: #a64f37;
    text-decoration: none;
    font-size: 12px;
    font-weight: 500;
  }

  .read-more span {
    transition: transform .3s;
  }

  .read-more:hover span {
    transform: translateX(5px);
  }

  .blog-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 65px;
    padding-top: 25px;
    border-top: 1px solid #dcc5a1;
  }

  .blog-bottom span,
  .blog-bottom a {
    font-size: 9px;
    letter-spacing: 2px;
  }

  .blog-bottom span {
    color: #77736a;
  }

  .blog-bottom a {
    color: #244537;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .blog-card:last-child {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .blog-preview {
      padding: 75px 6%;
    }

    .blog-heading {
      display: block;
    }

    .blog-heading-right {
      margin-top: 25px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .blog-card:last-child {
      grid-column: auto;
    }

    .blog-image {
      height: 280px;
    }

    .blog-card h3 {
      font-size: 27px;
    }

    .blog-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-image img,
    .blog-image-arrow,
    .read-more span {
      transition: none;
    }
  }
</style>
