
---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import AboutSection from "../components/home/AboutSection.astro";
import SanctuarySection from "../components/home/SanctuarySection.astro";
import ActivitiesSection from "../components/home/ActivitiesSection.astro";
import GallerySection from "../components/home/GallerySection.astro";
import BlogPreview from "../components/home/BlogPreview.astro";
import ContactSection from "../components/home/ContactSection.astro";
---

<BaseLayout
  title="Elephant Ride Jaipur | Elephant Experiences in Jaipur"
  description="Discover elephant rides, walking, feeding and other elephant experiences in Jaipur, Rajasthan. Explore visitor information and plan your visit."
  preloadImage="/images/activities/elephant-ride.webp"
>
  <Hero />

  <AboutSection />

  <SanctuarySection />

  <ActivitiesSection />

  <GallerySection />

  <BlogPreview />

  <ContactSection headingLevel="h2" />

</BaseLayout>
