---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/layout/PageIntro.astro";
import { activities } from "../../data/activities.js";
import { siteConfig } from "../../data/siteConfig.js";

export function getStaticPaths() {
  return activities.map((activity) => ({
    params: { slug: activity.slug },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const metaTitles = {
  "elephant-meeting": "Elephant Meeting & Introduction | Jaipur Elephant Ride",
  "elephant-ride": "Elephant Ride in Jaipur | Jaipur Elephant Ride",
  "walking-with-elephants": "Walking with the Elephants in Village | Jaipur Elephant Ride",
  "feeding-elephant": "Feeding the Elephant | Jaipur Elephant Ride",
  painting: "Paint On the Elephant | Jaipur Elephant Ride",
  bathing: "Shower with Elephant | Jaipur Elephant Ride",
};
const metaDescriptions = {
  "elephant-meeting":
    "Learn about elephant encounters in Jaipur. Contact Jaipur Elephant Ride to ask about current arrangements and visitor details.",
  "elephant-ride":
    "Explore the elephant ride experience in Jaipur. Contact Jaipur Elephant Ride to confirm availability and visit details.",
  "walking-with-elephants":
    "Discover walking with elephants in Jaipur. Ask Jaipur Elephant Ride about current arrangements and visitor guidance.",
  "feeding-elephant":
    "Learn about elephant feeding in Jaipur. Contact Jaipur Elephant Ride to confirm current availability and visitor guidance.",
  painting:
    "Explore elephant painting in Jaipur. Contact Jaipur Elephant Ride for current activity details.",
  bathing:
    "Learn about elephant bathing in Jaipur. Ask Jaipur Elephant Ride about current arrangements before visiting.",
};
const enquiry = encodeURIComponent(
  `Hello Jaipur Elephant Ride, I would like to enquire about ${activity.title}. Please share the current availability and visit details.`
);
---

<BaseLayout
  title={metaTitles[activity.slug] ?? `${activity.title} in Jaipur | Jaipur Elephant Ride`}
  description={metaDescriptions[activity.slug] ?? activity.description}
>
  <PageIntro
    eyebrow="JAIPUR ELEPHANT RIDE EXPERIENCE"
    title={activity.title}
    description={activity.introduction}
    image={activity.image}
  />

  <div class="activity-detail">
    <section class="activity-overview">
      <div>
        <p class="activity-eyebrow">ABOUT THIS EXPERIENCE</p>
        <h2>Discover {activity.title.toLowerCase()}.</h2>
      </div>
      <div class="activity-description">
        <p>{activity.details}</p>
        <p>
          Experience availability and arrangements can change. Contact
          Jaipur Elephant Ride to confirm details before your visit.
        </p>
        <div class="activity-actions">
          <a
            href={`https://wa.me/${siteConfig.whatsapp}?text=${enquiry}`}
            target="_blank"
            rel="noopener noreferrer"
            class="activity-whatsapp"
          >
            Enquire on WhatsApp <span>↗</span>
          </a>
          <a href="/experiences" class="activity-back">
            Back to all experiences <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="activity-photographs" aria-label={`${activity.title} photographs`}>
      <h2>Moments from the experience</h2>
      <div class="activity-photo-grid">
        {activity.supportingImages.map((photo) => (
          <img
            src={photo.src}
            alt={photo.alt}
            width={photo.dimensions.width}
            height={photo.dimensions.height}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .activity-detail {
    background: #f8f4eb;
  }

  .activity-overview {
    display: grid;
    grid-template-columns: 0.9fr 1fr;
    gap: 70px;
    max-width: 1440px;
    margin: auto;
    padding: 95px 7%;
  }

  .activity-eyebrow {
    color: #a64f37;
    font-size: 10px;
    letter-spacing: 3px;
  }

  .activity-overview h2,
  .activity-photographs h2 {
    margin: 18px 0 0;
    color: #244537;
    font-family: var(--font-heading);
    font-size: clamp(40px, 5vw, 62px);
    font-weight: 400;
    line-height: 1.1;
  }

  .activity-description p {
    margin: 0 0 18px;
    color: #706d65;
    font-size: 14px;
    line-height: 1.9;
  }

  .activity-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 30px;
  }

  .activity-whatsapp {
    display: inline-flex;
    gap: 18px;
    padding: 16px 21px;
    background: #244537;
    color: #f8f4eb;
    font-size: 13px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .activity-whatsapp:hover {
    background: #a64f37;
    transform: translateY(-2px);
  }

  .activity-back {
    color: #a64f37;
    font-size: 13px;
    text-decoration: none;
  }

  .activity-photographs {
    padding: 75px 7% 100px;
    background: #eee8dc;
  }

  .activity-photographs h2 {
    max-width: 1350px;
    margin: 0 auto 34px;
    font-size: clamp(36px, 4vw, 52px);
  }

  .activity-photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    max-width: 1350px;
    margin: auto;
  }

  .activity-photo-grid img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    background: #dcc5a1;
  }

  @media (max-width: 760px) {
    .activity-overview {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 70px 6%;
    }

    .activity-photographs {
      padding: 70px 6%;
    }

    .activity-photo-grid {
      grid-template-columns: 1fr;
    }

    .activity-photo-grid img {
      height: 360px;
    }
  }
</style>
